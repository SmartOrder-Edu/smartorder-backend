<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>smartorder-common</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>smartorder-common</name>
    <description>smartorder-common</description>
    <packaging>jar</packaging>

    <parent>
        <groupId>com.smartorder.edu</groupId>
        <artifactId>smartorder</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Neo4j 图数据库依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>

        <!-- Jackson Java 8 日期序列化支持（Redis 缓存用到 LocalDateTime） -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            Spring Retry：@RabbitListener 消费者重试（application-common.yml 中
            spring.rabbitmq.listener.simple.retry.*）需要 classpath 存在 RetryTemplate。
            spring-boot-starter-amqp 不传递该依赖，缺失时 retry 配置会被静默忽略。
        -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
    </dependencies>


</project>
