  "_query_suggestions": {
    "mastered": "items.filter(i => i.masteryScore >= 0.8)",
    "weak": "items.filter(i => i.masteryScore < 0.5)",
    "needsReview": "items.filter(i => new Date(i.nextReviewAt) <= now)",
    "highRetentionRisk": "items.filter(i => i.retentionRisk > 0.6)",
    "byChapter": "items.filter(i => i.chapterId === targetChapterId)"
