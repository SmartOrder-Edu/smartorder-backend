{
  "_comment": "全局学习偏好 — 回答：学生通常喜欢什么，以及什么方式实际效果更好？",
  "_dimension_id": "learningPreference",
  "_db_column": "learning_preference",
  "_data_source": "USER_DECLARED_AND_AB_TEST",
  "_update_frequency": "低频更新，偏好变化缓慢，需足够证据才更新",

  "_rules": [
    "必须区分 declaredPreference（用户自述偏好）和 observedEffectivePreference（系统验证有效偏好）",
    "declaredPreference 来自用户自述，可能与实际有效方式不同",
    "observedEffectivePreference 来自正确率、完成率等行为数据验证",
    "全局保存学生通常适合的默认偏好",
    "单科画像只保存该科目的特殊差异（subjectOverrides），设置 inheritGlobalPreference: true",
    "不要把全局偏好完整复制到每个单科画像"
  ],

  "_field_spec": {
    "declaredPreference": {
      "type": "object",
      "description": "用户自述偏好，来自问卷或对话"
    },
    "observedEffectivePreference": {
      "type": "object",
      "description": "系统根据行为数据验证的有效偏好"
    },
    "defaultExplanationSequence": {
      "type": "array",
      "item": "enum",
      "values": ["CONCRETE_EXAMPLE", "VISUAL_DEMONSTRATION", "CODE_TRACE", "FORMAL_DEFINITION", "ANALOGY", "STEP_BY_STEP_REASONING", "COMPARISON"],
      "description": "默认讲解顺序，按学生理解效果排列"
    },
    "defaultResourceTypePriority": {
      "type": "array",
      "item": "enum",
      "values": ["ANIMATION", "CODE_EXAMPLE", "DIAGRAM", "TEXT_DOCUMENT", "VIDEO", "INTERACTIVE_EXERCISE", "PRACTICE"],
      "description": "默认资源类型优先级"
    },
    "contentDetailLevel": {
      "type": "enum",
      "values": ["CONCISE", "MODERATE", "DETAILED", "COMPREHENSIVE"],
      "description": "内容详细程度偏好"
    },
    "interactionMode": {
      "type": "enum",
      "values": ["GUIDED_DIALOGUE", "FREE_EXPLORATION", "STRUCTURED_QA", "CHALLENGE_BASED"],
      "description": "交互模式偏好"
    },
    "practiceMode": {
      "type": "enum",
      "values": ["PROGRESSIVE_SCAFFOLDING", "IMMEDIATE_CHALLENGE", "MIXED", "DRILL_BASED"],
      "description": "练习模式偏好"
    },
    "feedbackMode": {
      "type": "enum",
      "values": ["IMMEDIATE_WITH_EXPLANATION", "DELAYED_SUMMARY", "PEER_COMPARISON", "HINT_FIRST"],
      "description": "反馈模式偏好"
    },
    "preferredSessionMinutes": {
      "type": "object",
      "fields": {
        "minimum": "int — 最短学习时长（分钟）",
        "maximum": "int — 最长学习时长（分钟）"
      },
      "description": "单次学习时长偏好"
    },
    "pacePreference": {
      "type": "enum",
      "values": ["FIXED", "ADAPTIVE", "SELF_PACED"],
      "description": "学习节奏偏好"
    },
    "preferenceConfidence": {
      "type": "float",
      "range": "0~1",
      "description": "偏好判断的整体置信度"
    }
  },

  "_example": {
    "declaredPreference": {},
    "observedEffectivePreference": {},
    "defaultExplanationSequence": [
      "CONCRETE_EXAMPLE",
      "VISUAL_DEMONSTRATION",
      "CODE_TRACE",
      "FORMAL_DEFINITION"
    ],
    "defaultResourceTypePriority": [
      "ANIMATION",
      "CODE_EXAMPLE",
      "DIAGRAM",
      "TEXT_DOCUMENT"
    ],
    "contentDetailLevel": "DETAILED",
    "interactionMode": "GUIDED_DIALOGUE",
    "practiceMode": "PROGRESSIVE_SCAFFOLDING",
    "feedbackMode": "IMMEDIATE_WITH_EXPLANATION",
    "preferredSessionMinutes": {
      "minimum": 20,
      "maximum": 45
    },
    "pacePreference": "ADAPTIVE",
    "preferenceConfidence": 0.78
  }
}
